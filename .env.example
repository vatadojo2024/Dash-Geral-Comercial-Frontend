# ============================================================================
# Mapa de Calor — variáveis de ambiente (copie para .env e preencha)
# Trocar os modos AQUI muda a fonte de dados sem tocar em componente.
# ============================================================================

# --- Dashboard de Produtividade SDR (api.infradojo.pro) ---------------------
# A chave fica SÓ no servidor (route handler /api/sdr-dashboard); nunca vai ao navegador.
SDR_DASHBOARD_API_URL=https://api.infradojo.pro/dashboard_comercial
SDR_DASHBOARD_API_KEY=coloque-a-chave-aqui
# "mock" usa src/lib/mock/sdr_dashboard.json; "api" chama a API real.
SDR_DASHBOARD_MODE=mock

# --- Leads (GET /api/leads do backend Fastify) -------------------------------
# "mock" (default) usa src/lib/mock/data_clients.json; "api" repassa para
# {NEXT_PUBLIC_API_URL}/api/leads com o Bearer da sessão Supabase.
LEADS_MODE=mock
NEXT_PUBLIC_API_URL=https://mapacalor-api.infradojo.pro

# --- Autenticação ------------------------------------------------------------
# "mock" (default) valida o e-mail contra a lista de usuários (qualquer senha);
# "supabase" usa o Supabase Auth real (e-mail/senha) na MESMA tela de login.
AUTH_MODE=mock
NEXT_PUBLIC_SUPABASE_URL=https://coloque-o-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui
